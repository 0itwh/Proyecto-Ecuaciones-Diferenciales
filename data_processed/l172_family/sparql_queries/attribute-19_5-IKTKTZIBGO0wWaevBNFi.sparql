PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX mm: <http://materialsmine.org/ns/>
PREFIX prov: <http://www.w3.org/ns/prov#>SELECT DISTINCT ?AttrType ?value (GROUP_CONCAT(DISTINCT ?unit; SEPARATOR="; ") AS ?Units) WHERE {
    VALUES ?sample { <http://materialsmine.org/sample/l172-s8-huo-2015> }
      ?sample a mm:PolymerNanocomposite ;
              sio:hasAttribute ?attr .
      FILTER NOT EXISTS { ?attr sio:inRelationTo ?otherAttr }
      ?attr a ?AttrType ; 
            sio:hasValue ?value .
      OPTIONAL {
        ?attr sio:hasUnit [ rdfs:label ?unit ]
      }
    } GROUP BY ?attr ?AttrType ?value
